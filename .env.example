# ==============================================================================
# DairyFlow - Environment Configuration Example
# ==============================================================================
# Copy this file to .env before starting the services locally:
# cp .env.example .env
# ==============================================================================

# Application Profile
SPRING_PROFILES_ACTIVE=dev
APP_PORT=8080

# ------------------------------------------------------------------------------
# DATABASE (PostgreSQL)
# ------------------------------------------------------------------------------
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=dairyflow_db
DATABASE_USERNAME=dairyflow_user
DATABASE_PASSWORD=dairyflow_secret_password
DATABASE_URL=jdbc:postgresql://localhost:5432/dairyflow_db

# ------------------------------------------------------------------------------
# CACHE (Redis)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# SECURITY (JWT & Encryption)
# ------------------------------------------------------------------------------
# Minimum 256-bit base64-encoded secret key for HMAC-SHA256
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# ------------------------------------------------------------------------------
# FILE STORAGE (S3-Compatible Object Storage)
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=local
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=dairyflow-storage
S3_REGION=us-east-1

# ------------------------------------------------------------------------------
# FRONTEND (Next.js)
# ------------------------------------------------------------------------------
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_APP_NAME="DairyFlow"
